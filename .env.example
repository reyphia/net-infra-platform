# Copy this file to .env and fill in real values before running
# `docker compose up`. Never commit a real .env file.

ENVIRONMENT=production

# SQLite by default; swap for a postgresql+asyncpg:// DSN for production
# multi-user deployments (the ORM layer is Postgres-compatible as-is).
DATABASE_URL=sqlite+aiosqlite:///./data/platform.db

# Signs session/API tokens. Generate with: openssl rand -hex 32
SECRET_KEY=

# Encrypts credential profiles at rest (Fernet key). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SSH
SSH_KNOWN_HOSTS_PATH=./data/known_hosts
SSH_CONNECT_TIMEOUT_SECONDS=8.0
SSH_COMMAND_TIMEOUT_SECONDS=20.0
# Disables host-key verification. Only ever set true for an isolated lab
# environment you control -- see docs/security.md.
SSH_ALLOW_INSECURE_LAB_MODE=false

# Discovery defaults (all overridable per-job via the API/UI)
DISCOVERY_DEFAULT_TIMEOUT_SECONDS=2.0
DISCOVERY_DEFAULT_MAX_CONCURRENCY=50
DISCOVERY_DEFAULT_RETRY_COUNT=1

# SNMP defaults -- leave community blank; provide it per discovery job or
# per credential profile instead of storing it here.
SNMP_DEFAULT_PORT=161
SNMP_DEFAULT_TIMEOUT_SECONDS=2.0

CONFIG_BACKUP_DIR=./data/backups
